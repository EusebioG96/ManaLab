{{> cabecera_en 1=d}}
<main id="inicio">
<section class="portada">
<div class="envoltura">
<div>
<div class="eti">Free tracker for MTG Arena and Magic Online</div>
<h1>Every Arena and Magic Online match, <em>logged on its own.</em></h1>
<p class="sub">ManaLab reads the Arena and Magic Online logs while you play and keeps your hands, mulligans and the opponent's deck. Then it shows where you win and lose.</p>
<div data-movil-aqui></div>
<div class="hero-cta">
<a class="boton prim descarga" href="https://github.com/EusebioG96/ManaLab/releases/download/v2.3.2/ManaLab-2.3.2-portable.zip" download data-a-bloque data-descarga data-goatcounter-click="descarga" data-goatcounter-title="descarga-hero-en" rel="noopener"><svg viewbox="0 0 24 24"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"></path></svg><span>Download free</span></a>
<a class="enlace-sec" href="#capturas">See the app</a>
</div>
<p class="nota-hero"><span>Version <span data-version>2.3.2</span> · ZIP · nothing to install</span><a href="/safety/">Is it safe? Check it yourself →</a></p>
<div class="nota-desc"><span>The app is free. Only the AI is paid</span><span>Your data stays on your PC unless you ask for AI</span><span>App in 9 languages</span></div>
</div>
<div class="hero-medio">
<div class="hero-video" id="hero-video">
<video aria-label="Silent 15-second video of ManaLab with demo data: the match list with wins and losses logged on their own, a game with its opening hand, mulligans and screenshot, win rate by matchup and play/draw, and a step-by-step replay." autoplay="" height="720" loop="" muted="" playsinline="" poster="video/hero/manalab-hero-en-poster.jpg" preload="metadata" width="1280">
<source src="video/hero/manalab-hero-en.webm" type="video/webm"/>
<source src="video/hero/manalab-hero-en.mp4" type="video/mp4"/>
</video>
<button aria-label="Pause video" class="hero-pausa" data-pausa="Pause video" data-play="Play video" type="button"><svg aria-hidden="true" class="ico-pausa" viewbox="0 0 24 24"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path></svg><svg aria-hidden="true" class="ico-play" viewbox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg></button>
</div>
<script>
(function () {
  /* con «reducir movimiento» o ahorro de datos: solo el póster (no se descarga el vídeo).
     En teléfono (pantalla táctil estrecha) también: el póster con el botón de reproducir; el vídeo se descarga al tocarlo (ML-154) */
  var caja = document.getElementById("hero-video"), v = caja.querySelector("video"), b = caja.querySelector(".hero-pausa");
  var c = navigator.connection || {};
  var quieto = (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) || c.saveData === true;
  if (quieto) {
    v.removeAttribute("autoplay"); v.autoplay = false; v.preload = "none";
    v.querySelectorAll("source").forEach(function (s) { s.remove(); });
    v.load(); caja.classList.add("solo-poster");
    return;
  }
  var fuentes = null;
  if (window.matchMedia && window.matchMedia("(max-width: 767px) and (pointer: coarse)").matches) {
    v.removeAttribute("autoplay"); v.autoplay = false; v.preload = "none";
    fuentes = Array.prototype.map.call(v.querySelectorAll("source"), function (s) { s.remove(); return s; });
    v.load();
    b.classList.add("pausado"); b.setAttribute("aria-label", b.dataset.play);
    v.style.cursor = "pointer";
    v.addEventListener("click", function () { b.click(); });   /* en teléfono, tocar cualquier parte del vídeo lo reproduce o pausa */
  }
  b.addEventListener("click", function () {
    if (fuentes) {   /* primer toque en teléfono: ahora sí se añaden las fuentes */
      fuentes.forEach(function (s) { v.appendChild(s); });
      fuentes = null; v.preload = "auto"; v.load();
    }
    if (v.paused) v.play(); else v.pause();
  });
  v.addEventListener("play", function () { b.classList.remove("pausado"); b.setAttribute("aria-label", b.dataset.pausa); });
  v.addEventListener("pause", function () { b.classList.add("pausado"); b.setAttribute("aria-label", b.dataset.play); });
})();
</script>
</div>
</div>
