<!-- Hueco de MDN (Metafy) que la app de ManaLab enseña al final del Panel. No se enlaza desde la web.
     Ocupa todo el ancho: MDN no pone nada en un hueco de menos de 728 px y, centrado en flex, el hueco medía 0. -->
<div data-mdn="leaderboard" data-mdn-hint="sessions" data-mdn-fallback-scope="same_game" data-mdn-theme="dark"></div>
<script async src="https://mdn.metafy.gg/embed.js" data-mdn-site="mdn_obNMYPWbbmMClWCpy3Pss6JY"></script>
</body>
