<script>
(function () {
  "use strict";
  var base = "../img/es_";
  document.querySelectorAll(".pestanas button").forEach(function (b) {
    b.addEventListener("click", function () {
      document.querySelectorAll(".pestanas button").forEach(function (x) { x.setAttribute("aria-selected", x === b ? "true" : "false"); });
      var img = document.getElementById("galeria");
      img.dataset.cap = b.dataset.tab;
      img.src = base + b.dataset.tab + ".jpg";
      var fuente = img.parentNode.querySelector("source");   /* la <picture> con WebP (ML-154) */
      if (fuente) fuente.srcset = base + b.dataset.tab + ".webp";
      var fuente = img.parentNode.querySelector("source");   /* la <picture> con WebP (ML-154) */
      if (fuente) fuente.srcset = base + b.dataset.tab + ".webp";
    });
  });
})();
</script><script>
(function () {
  /* un <details> cerrado no se ve: al entrar por #magic-online (u otra pregunta con id) se abre sola */
  function abrir() {
    var d = null;
    try { d = location.hash.length > 1 && document.getElementById(decodeURIComponent(location.hash.slice(1))); } catch (e) {}
    if (d && d.tagName === "DETAILS") { d.open = true; d.scrollIntoView({ behavior: "instant" }); }
  }
  abrir();
  window.addEventListener("load", abrir);   /* otra vez con las imágenes ya cargadas: el desplazamiento cuadra */
  window.addEventListener("hashchange", abrir);
})();
</script><script data-goatcounter="https://manalab.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script></body>
</html>