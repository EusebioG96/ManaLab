/* Misma identidad que la portada: paneles oscuros carmesi, un solo mundo visual (oscuro, como el programa). */
:root {
  color-scheme: dark;
  --fondo: #0d0304; --fondo2: #150608; --panel: #1c0b0e; --panel2: #281215;
  --linea: rgba(255, 214, 200, 0.09); --linea2: rgba(255, 214, 200, 0.16);
  --texto: #f3e8e2; --texto2: #cbb6af; --apagado: #957f79;
  --carmesi: #c2363f; --carmesi-h: #d6454f; --oro: #e9b37f; --oro-suave: rgba(233, 179, 127, 0.13);
  --f-display: "Saira Semi Condensed", "Bahnschrift", "Arial Narrow", system-ui, sans-serif;
  --f-texto: "Figtree", "Segoe UI", system-ui, -apple-system, sans-serif;
  --f-mono: ui-monospace, "Cascadia Mono", Consolas, monospace;
  --ancho: 1120px;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { animation: none !important; transition: none !important; } }
body { margin: 0; background: var(--fondo); color: var(--texto); font: 16px/1.65 var(--f-texto); -webkit-font-smoothing: antialiased; }
a { color: var(--oro); }
a:focus-visible, button:focus-visible { outline: 2px solid var(--oro); outline-offset: 3px; border-radius: 6px; }
img { max-width: 100%; display: block; }
.envoltura { max-width: var(--ancho); margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
h1, h2 { font-family: var(--f-display); font-weight: 600; letter-spacing: 0.2px; text-wrap: balance; margin: 0; }
.eti { font: 600 12px/1 var(--f-display); letter-spacing: 2.2px; text-transform: uppercase; color: var(--oro); }

/* cabecera (la de la portada) */
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: rgba(13, 3, 4, 0.92); }
.cab { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 9; background: rgba(13, 3, 4, 0.82); backdrop-filter: blur(12px); border-bottom: 1px solid var(--linea); }
.cab .envoltura { display: flex; align-items: center; gap: 22px; padding-block: 12px; }
.marca { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--texto); margin-right: auto; }
.marca img { width: 36px; height: 36px; }
.marca b { font: 600 19px/1 var(--f-display); letter-spacing: 0.3px; }
.cab nav { display: flex; gap: 22px; }
.cab nav a { color: var(--texto2); text-decoration: none; font-size: 14.5px; }
.cab nav a:hover { color: var(--texto); }
.idioma { border: 1px solid var(--linea2); background: none; color: var(--texto2); border-radius: 999px; padding: 5px 11px; font: 600 12px var(--f-display); letter-spacing: 1px; text-decoration: none; display: inline-grid; place-items: center; }
.idioma:hover { color: var(--texto); border-color: var(--apagado); }
.boton { display: inline-flex; align-items: center; gap: 10px; border-radius: 999px; padding: 11px 22px; font: 600 15px var(--f-texto); text-decoration: none; border: 1px solid transparent; white-space: nowrap; transition: background .15s, transform .1s; }
.boton:active { transform: translateY(1px); }
.boton.prim { background: var(--carmesi); color: #fff5f0; box-shadow: 0 10px 28px -12px rgba(194, 54, 63, 0.9); }
.boton.prim:hover { background: var(--carmesi-h); }
.boton svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.cab .boton { padding: 8px 16px; font-size: 14px; }

/* pagina */
.portada { position: relative; overflow: hidden; padding-block: 64px 12px; }
.portada::before { content: ""; position: absolute; inset: -60% -10% auto 35%; height: 560px; background: radial-gradient(closest-side, rgba(194, 54, 63, 0.2), transparent 70%); pointer-events: none; }
.pagina { position: relative; max-width: 760px; margin: 0 auto; }
.portada h1 { font-size: clamp(34px, 5vw, 54px); line-height: 1.05; margin: 16px 0 18px; }
.lead { font-size: 18.5px; color: var(--texto2); margin: 0; max-width: 36em; }
.cuerpo { padding-block: 28px 80px; }
.cuerpo .pagina { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; }
.tarjeta { background: var(--panel); border: 1px solid var(--linea); border-radius: 18px; padding: 28px 30px 30px; scroll-margin-top: 84px; }
.tarjeta h2 { font-size: clamp(24px, 3vw, 30px); line-height: 1.12; margin: 0 0 14px; }
.tarjeta p { margin: 0 0 12px; color: var(--texto2); }
.tarjeta p:last-child { margin-bottom: 0; }
.tarjeta ul, .tarjeta ol { list-style: none; margin: 0 0 14px; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; color: var(--texto2); }
.tarjeta ul:last-child, .tarjeta ol:last-child { margin-bottom: 0; }
.tarjeta li { position: relative; padding-left: 36px; }
.tarjeta ul li::before { content: "✓"; position: absolute; left: 4px; top: 0; color: var(--oro); font-weight: 700; }
.tarjeta ol { counter-reset: n; }
.tarjeta ol li { counter-increment: n; }
.tarjeta ol li::before { content: counter(n); position: absolute; left: 0; top: 2px; width: 24px; height: 24px; border-radius: 50%; border: 1px solid var(--linea2); background: var(--panel2); color: var(--oro); font: 600 13px/22px var(--f-display); text-align: center; }
.tarjeta b { color: var(--texto); font-weight: 600; }
code { font: 0.88em var(--f-mono); background: var(--fondo); border: 1px solid var(--linea); border-radius: 6px; padding: 1px 6px; color: var(--texto); }
.cmd { margin: 10px 0 8px; background: #080102; border: 1px solid var(--linea); border-radius: 10px; padding: 12px 14px; overflow-x: auto; }
.cmd code { background: none; border: 0; padding: 0; font-size: 13.5px; white-space: pre; }
.firma { margin: 8px 4px 0; font: 600 18px var(--f-display); color: var(--oro); letter-spacing: 0.3px; }

/* pie (el de la portada) */
footer { border-top: 1px solid var(--linea); padding-block: 36px; color: var(--apagado); font-size: 13.5px; }
footer .envoltura { display: grid; gap: 14px; }
footer .fila { display: flex; flex-wrap: wrap; gap: 10px 24px; align-items: center; }
footer .guias { gap: 6px 16px; }
footer .guias a { color: inherit; }
footer .guias b { color: var(--texto2); font-weight: 600; }
footer .legal { max-width: 80ch; line-height: 1.6; margin: 0; }

@media (max-width: 900px) { .cab nav { display: none; } .portada { padding-block: 40px 8px; } }
@media (max-width: 480px) {
  .cab .boton span { display: none; }
  .tarjeta { padding: 22px 18px 24px; border-radius: 16px; }
  .tarjeta li { padding-left: 32px; }
  .lead { font-size: 17px; }
  .cmd code { white-space: pre-wrap; overflow-wrap: anywhere; }
}

