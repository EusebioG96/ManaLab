/* ---------------- post del blog «Learn» (ML-345): una columna de lectura bajo el H1 */
.blog-learn .portada.solo { padding-block: 44px 0; }
.blog-learn .portada.solo h1 { line-height: 1.1; }
.blog-learn .autoria { margin: 16px 0 0; font-size: 15px; color: var(--texto2); }
.blog-learn .seccion { padding-block: 28px 56px; }
.blog-learn .seccion .envoltura { max-width: 900px; }
.blog-learn .cuerpo-blog { max-width: 720px; font-size: 18px; line-height: 1.7; color: var(--texto2); overflow-wrap: break-word; }
.blog-learn .cuerpo-blog p { margin: 0 0 18px; }
.blog-learn .cuerpo-blog h2 { font-size: clamp(24px, 3vw, 32px); line-height: 1.2; margin: 40px 0 14px; color: var(--texto); }
.blog-learn .cuerpo-blog strong { color: var(--texto); font-weight: 600; }
.blog-learn .cuerpo-blog ul { margin: 0 0 18px; padding-left: 22px; display: grid; gap: 10px; }
.blog-learn .cuerpo-blog p a:not(.boton), .blog-learn .cuerpo-blog li a { color: var(--texto); }
.blog-learn .cuerpo-blog .boton { max-width: 100%; box-sizing: border-box; }
.blog-learn .cuerpo-blog .antes { font-size: 16px; margin: 4px 0 0; }
@media (max-width: 900px) { .blog-learn .portada.solo { padding-block: 28px 0; } .blog-learn .seccion { padding-block: 20px 40px; } }
@media (max-width: 480px) { .blog-learn .cuerpo-blog { font-size: 17px; } }
