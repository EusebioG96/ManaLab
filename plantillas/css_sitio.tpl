/* Línea visual «La mesa de juego» (ML-272): una mesa oscura verdosa, hueso como color de acción, oro solo en antetítulos y aviso de versión.
   Fuentes: Marcellus (títulos), Geist (texto) y Geist Mono (idiomas, código, marcadores), servidas desde /fuentes/. */
:root {
  color-scheme: dark;
  --fondo: #0d100f; --fondo2: #111513; --panel: #141917; --panel2: #1b211e;
  --linea: rgba(236, 230, 214, 0.12); --linea2: rgba(236, 230, 214, 0.26);
  --texto: #ece6d6; --texto2: #b9b2a1; --apagado: #9a9484;
  --hueso: #ece6d6; --hueso-h: #ffffff;
  --oro: #e2b45c; --oro-suave: rgba(226, 180, 92, 0.12);
  --ko: #ef9a86; --ko-suave: rgba(239, 154, 134, 0.13);
  --f-display: "Marcellus", Georgia, "Times New Roman", serif;
  --f-texto: "Geist", "Segoe UI", system-ui, -apple-system, sans-serif;
  --f-mono: "Geist Mono", ui-monospace, "Cascadia Mono", Consolas, monospace;
  --ancho: 1180px;
}
/* japonés: Marcellus y Geist no tienen esas letras; pila del sistema */
:root:lang(ja) {
  --f-display: "Yu Gothic UI", "Hiragino Sans", "Noto Sans CJK JP", "Noto Sans CJK KR", "Noto Sans CJK SC", "Malgun Gothic", "Microsoft YaHei", system-ui, sans-serif;
  --f-texto: "Yu Gothic UI", "Hiragino Sans", "Noto Sans CJK JP", "Noto Sans CJK KR", "Noto Sans CJK SC", "Malgun Gothic", "Microsoft YaHei", system-ui, sans-serif;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { animation: none !important; transition: none !important; } }
body { margin: 0; background: radial-gradient(1300px 760px at 70% -6%, #22302a 0%, #0d100f 60%) no-repeat var(--fondo); color: var(--texto); font: 16px/1.6 var(--f-texto); -webkit-font-smoothing: antialiased; }
a { color: var(--texto); text-decoration-color: var(--linea2); text-underline-offset: 3px; }
a:hover { text-decoration-color: currentColor; }
a:focus-visible, button:focus-visible, summary:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--hueso); outline-offset: 2px; }
img { max-width: 100%; display: block; }
.envoltura { max-width: var(--ancho); margin: 0 auto; padding-left: max(20px, env(safe-area-inset-left, 0px)); padding-right: max(20px, env(safe-area-inset-right, 0px)); }
h1, h2, h3 { font-family: var(--f-display); font-weight: 400; letter-spacing: 0.005em; text-wrap: balance; margin: 0; }
:lang(ja) h1, :lang(ja) h2, :lang(ja) h3 { font-weight: 600; }
code { font-family: var(--f-mono); border-radius: 4px; background: var(--panel2); border-color: var(--linea); }
.eti { font: 500 13px/1.3 var(--f-texto); letter-spacing: 0.14em; text-transform: uppercase; color: var(--oro); }

/* ---------------- cabecera */
{{@1}}
.nota-descarga a { color: inherit; text-decoration: underline; }
{{@2}}
.nota-smartscreen b { color: var(--texto); }
.aviso-version { border-bottom: 1px solid var(--linea); font-size: 14px; color: var(--texto); }
.aviso-version .envoltura { display: flex; align-items: center; justify-content: space-between; gap: 10px 18px; flex-wrap: wrap; padding-block: 9px; }
.aviso-version b { color: var(--oro); font-weight: 500; }
.aviso-version a { color: var(--texto2); font-weight: 400; white-space: nowrap; text-decoration: underline; }
.aviso-version span a { white-space: normal; }
{{> css_cabecera}}

/* ---------------- portada */
{{@3}}
.portada .envoltura { position: relative; display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: 56px; align-items: center; }
{{@4}}
.portada h1 em { font-style: normal; color: inherit; }
{{@5}}
.acciones { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
{{@6}}
.nota-desc span::before, .confianza-lista b::before { content: ""; display: inline-block; width: 8px; height: 8px; transform: rotate(45deg); background: var(--hueso); margin-right: 12px; vertical-align: 1px; }
/* vídeo de cabecera (ML-058): 15 s sin sonido en bucle; con «reducir movimiento» o ahorro de datos solo se ve el póster */
.hero-medio { display: grid; gap: 18px; justify-items: start; min-width: 0; }
/* la ventana con captura ocupa todo el ancho de la columna: sin esto, con justify-items:start, mide 2 px hasta que carga la imagen y la página salta (ML-406) */
.hero-medio .ventana { width: 100%; }
.hero-video { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; border: 1px solid rgba(236, 230, 214, 0.34); background: var(--panel); box-shadow: 0 40px 70px rgba(0, 0, 0, 0.6); }
.hero-video video { display: block; width: 100%; height: 100%; object-fit: cover; }
.hero-pausa { position: absolute; right: 8px; top: 8px; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--linea2); background: rgba(13, 16, 15, 0.72); color: var(--texto2); display: grid; place-items: center; cursor: pointer; padding: 0; opacity: 0.75; }
.hero-pausa:hover, .hero-pausa:focus-visible { opacity: 1; color: var(--texto); }
.hero-pausa svg { width: 14px; height: 14px; fill: currentColor; }
.hero-pausa .ico-play, .hero-pausa.pausado .ico-pausa { display: none; }
.hero-pausa.pausado .ico-play { display: block; }
.hero-video.solo-poster .hero-pausa { display: none; }
.hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; }
{{@7}}
.enlace-sec { color: var(--texto2); font-size: 14.5px; text-decoration: underline; text-decoration-color: var(--linea2); text-underline-offset: 3px; }
.enlace-sec:hover { color: var(--texto); text-decoration-color: currentColor; }
.ventana { border-radius: 10px; border: 1px solid rgba(236, 230, 214, 0.34); background: var(--panel); box-shadow: 0 40px 70px rgba(0, 0, 0, 0.6); overflow: hidden; }
.ventana .barra { display: flex; gap: 6px; padding: 10px 12px; border-bottom: 1px solid var(--linea); align-items: center; }
.ventana .barra i { width: 9px; height: 9px; border-radius: 50%; background: var(--linea2); }
.ventana .barra span { margin-left: 8px; font: 500 11.5px var(--f-texto); color: var(--apagado); }
.ventana img { width: 100%; height: auto; object-fit: cover; object-position: top left; }
.ventana img.cap { aspect-ratio: 1366 / 860; }

/* ---------------- del log al historial */
{{@8}}
.seccion.franja { background: rgba(236, 230, 214, 0.025); border-block: 1px solid var(--linea); }
{{@9}}
.cab-sec h2 { font-size: clamp(28px, 3.4vw, 42px); line-height: 1.12; margin: 14px 0 12px; }
.cab-sec p { color: var(--texto2); margin: 0; font-size: 17px; line-height: 1.6; }
.conversion { display: grid; grid-template-columns: minmax(0, 1.1fr) auto minmax(0, 1fr); gap: 22px; align-items: center; }
.log { background: #0a0c0b; border: 1px solid var(--linea); border-radius: 8px; padding: 18px 18px 16px; font: 12.5px/1.7 var(--f-mono); color: var(--apagado); overflow-x: auto; min-width: 0; }
.log .t { color: var(--apagado); display: block; margin-bottom: 8px; font-family: var(--f-texto); font-size: 12px; }
.log b { color: var(--texto); font-weight: 500; }
.log .k { color: #cfc8b6; }
.log pre { margin: 0; white-space: pre; }
.flecha-c { color: var(--apagado); }
.flecha-c svg { width: 34px; height: 34px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.match { background: var(--panel); border: 1px solid var(--linea2); border-radius: 8px; padding: 16px; min-width: 0; }
.m-cab { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: 12px; align-items: center; }
.res { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font: 600 15px var(--f-mono); background: var(--hueso); color: var(--fondo); }
.m-nom { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.m-sub { font-size: 13px; color: var(--apagado); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.marcador { font: 500 18px var(--f-mono); font-variant-numeric: tabular-nums; display: flex; gap: 10px; align-items: center; }
.puntos { display: flex; gap: 5px; } .puntos i { width: 8px; height: 8px; transform: rotate(45deg); background: var(--hueso); } .puntos i.d { background: none; border: 1.5px solid #8c8676; }
.juegos { margin: 12px 0 0 52px; display: grid; gap: 4px; }
{{@10}}
.juego .g { color: var(--apagado); font-size: 12.5px; }
.chip { justify-self: start; font: 500 11.5px var(--f-texto); border-radius: 4px; padding: 2px 9px; background: rgba(236, 230, 214, 0.12); color: var(--texto); }
.chip.d { background: none; box-shadow: inset 0 0 0 1px #8c8676; color: var(--ko); }
.mano { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px; }
.mano span { font-size: 12px; background: var(--panel2); border: 1px solid var(--linea); border-radius: 4px; padding: 3px 8px; }
.mano span b { color: var(--texto); font: 600 12px var(--f-mono); margin-right: 3px; }

/* ---------------- funciones */
.funciones { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--linea); border: 1px solid var(--linea); border-radius: 8px; overflow: hidden; }
.funcion { background: #0f1312; padding: 28px 26px 30px; }
.funcion svg { width: 26px; height: 26px; fill: none; stroke: var(--hueso); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.funcion h3 { font-size: 22px; margin: 14px 0 8px; }
.funcion p { margin: 0; color: var(--texto2); font-size: 16px; line-height: 1.6; }

/* ---------------- capturas */
.pestanas { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px; }
.pestanas button { border: 1px solid var(--linea2); background: none; color: var(--texto2); border-radius: 4px; min-height: 36px; padding: 0 14px; font: 500 13px var(--f-texto); cursor: pointer; }
.pestanas button[aria-selected="true"] { background: var(--hueso); border-color: var(--hueso); color: var(--fondo); font-weight: 600; }
{{@11}}

/* ---------------- pasos */
.pasos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; counter-reset: paso; }
.paso { border-top: 1px solid var(--linea2); padding-top: 24px; }
.paso::before { counter-increment: paso; content: counter(paso); display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--hueso); color: var(--fondo); font: 600 18px/1 var(--f-mono); }
.paso h3 { font-size: 24px; margin: 16px 0 10px; }
.paso p { margin: 0; color: var(--texto2); font-size: 16px; line-height: 1.6; }
.ruta { font: 13px var(--f-mono); background: var(--panel2); border: 1px solid var(--linea); border-radius: 4px; padding: 2px 7px; color: var(--texto); white-space: nowrap; }

/* ---------------- preguntas */
.preguntas { display: grid; gap: 0; max-width: 820px; border-bottom: 1px solid var(--linea); }
/* :where(:not(.menu)) deja fuera el menú de teléfono sin subir la especificidad de estas reglas */
details:where(:not(.menu)) { background: none; border: 0; border-top: 1px solid var(--linea); border-radius: 0; padding: 4px 0; }
summary { cursor: pointer; list-style: none; }
summary::-webkit-details-marker { display: none; }
details:where(:not(.menu)) > summary { padding: 16px 0; font-size: 18px; font-weight: 500; display: flex; justify-content: space-between; gap: 16px; }
details:where(:not(.menu)) > summary::after { content: "+"; color: var(--texto2); font: 400 22px/1 var(--f-texto); }
details:where(:not(.menu))[open] > summary::after { content: "–"; }
details p { margin: 0 0 16px; color: var(--texto2); font-size: 17px; line-height: 1.6; max-width: 70ch; }

/* ---------------- apoyo */
.apoyo { margin-top: 24px; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 40px; align-items: center; background: var(--panel); border: 1px solid var(--linea2); border-radius: 8px; box-shadow: inset 0 0 0 4px var(--panel), inset 0 0 0 5px rgba(236, 230, 214, 0.1); padding: 44px; }
{{@12}}
.apoyo p { color: var(--texto2); margin: 0 0 12px; }
.ia-caja { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 40px; align-items: center; background: var(--panel); border: 1px solid var(--linea2); border-radius: 8px; padding: 44px; box-shadow: inset 0 0 0 4px var(--panel), inset 0 0 0 5px rgba(236, 230, 214, 0.1); }
.final-caja h2 { font-size: clamp(30px, 4vw, 48px); }
.ia-caja h2 { font-size: clamp(28px, 3.4vw, 42px); line-height: 1.12; margin: 14px 0 12px; }
.ia-caja p { color: var(--texto2); margin: 0 0 12px; }
.ia-precio { font: 400 clamp(56px, 7vw, 84px)/1 var(--f-display); color: var(--texto); font-variant-numeric: tabular-nums; }
.ia-precio small { font-family: var(--f-texto); font-size: 0.3em; color: var(--texto2); font-weight: 500; margin-left: 6px; }
.ia-lista { border-top: 1px solid var(--linea2); padding-top: 18px; margin-top: 18px; }
.ia-lista p { font-size: 15px; }
.contacto { max-width: 680px; display: grid; gap: 16px; }
.contacto label { display: grid; gap: 6px; color: var(--texto2); font-size: 15px; }
.contacto input, .contacto select, .contacto textarea { background: rgba(13, 16, 15, 0.7); color: var(--texto); border: 1px solid var(--linea2); border-radius: 4px; min-height: 42px; padding: 10px 12px; font: inherit; }
.contacto .casilla { display: flex; gap: 10px; align-items: flex-start; }
.contacto .casilla input { margin-top: 5px; }
.rejilla-contacto { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
@media (max-width: 600px) { .rejilla-contacto { grid-template-columns: minmax(0, 1fr); } }
.pronto { color: var(--texto2); font-size: 16px; }
/* botón de Metafy (VIS-04, punto 4), tamaño grande; solo se genera con enlace en contenido.json */
.b-metafy { display: inline-flex; align-items: center; gap: 14px; min-height: 56px; padding: 0 24px 0 18px; border-radius: 6px; border: 1.5px solid transparent; background: linear-gradient(#141917, #141917) padding-box, linear-gradient(100deg, #F9CED5, #FFE7B7 53%, #D4F2FE) border-box; color: var(--texto); font: 600 16px var(--f-texto); text-decoration: none; }
.b-metafy img { height: 30px; width: auto; }

/* ---------------- pie */
footer { border-top: 1px solid var(--linea); padding-block: 36px; color: var(--apagado); font-size: 13.5px; }
footer .envoltura { display: grid; gap: 14px; }
footer .fila { display: flex; flex-wrap: wrap; gap: 10px 24px; align-items: center; }
footer a { color: var(--texto2); }
footer .guias { gap: 6px 16px; }
footer .guias a { color: inherit; }
footer .guias b { color: var(--texto2); font-weight: 600; }
footer .legal { max-width: 80ch; line-height: 1.6; }

@media (max-width: 900px) {
  .portada .envoltura, .apoyo, .ia-caja, .conversion { grid-template-columns: minmax(0, 1fr); }
  .flecha-c { justify-self: center; transform: rotate(90deg); }
  .funciones, .pasos { grid-template-columns: minmax(0, 1fr); }
  .portada { padding-block: 36px 28px; }
  .portada .envoltura { gap: 32px; }
  .seccion { padding-block: 48px; }
  .cab-sec { margin-bottom: 26px; }
  .ia-caja, .apoyo { padding: 28px 22px; }
}
/* ML-326b: la cabecera pasa al menú de teléfono mientras su fila de escritorio no cabe entera en una línea. Cada cabecera dice en
   data-compacta (en su logotipo) desde qué ancho cabe su fila; en las demás cabe a 900 px. Hay un tramo por valor (mismas tres reglas). */
@media (max-width: 1079px) {
  .cab .envoltura:has(> .marca[data-compacta="1080"]) { gap: 10px 12px; }
  .cab .envoltura:has(> .marca[data-compacta="1080"]) > nav, .cab .envoltura:has(> .marca[data-compacta="1080"]) > .idioma { display: none; }
  .cab .envoltura:has(> .marca[data-compacta="1080"]) > .menu { display: block; }
}
@media (max-width: 1129px) {
  .cab .envoltura:has(> .marca[data-compacta="1130"]) { gap: 10px 12px; }
  .cab .envoltura:has(> .marca[data-compacta="1130"]) > nav, .cab .envoltura:has(> .marca[data-compacta="1130"]) > .idioma { display: none; }
  .cab .envoltura:has(> .marca[data-compacta="1130"]) > .menu { display: block; }
}
@media (max-width: 1179px) {
  .cab .envoltura:has(> .marca[data-compacta="1180"]) { gap: 10px 12px; }
  .cab .envoltura:has(> .marca[data-compacta="1180"]) > nav, .cab .envoltura:has(> .marca[data-compacta="1180"]) > .idioma { display: none; }
  .cab .envoltura:has(> .marca[data-compacta="1180"]) > .menu { display: block; }
}
/* la cabecera en español de la portada lleva siete enlaces y no cabe en 1180 px con los huecos de siempre: huecos algo menores, la misma letra */
@media (min-width: 1180px) {
  .cab .envoltura:has(> .marca[data-denso]) { gap: 18px 20px; }
  .cab .envoltura:has(> .marca[data-denso]) > nav { gap: 14px; }
  .cab .envoltura:has(> .marca[data-denso]) > .idioma { padding-inline: 8px; }
}
@media (max-width: 560px) {
  .hero-cta .boton, .final-caja .boton, .paso .boton, .movil-caja .boton { width: 100%; justify-content: center; }
}
@media (max-width: 480px) {
  .juegos { margin-left: 0; }
}

/* ---------------- teléfono: en lugar del ZIP, «envíate el enlace» (lo monta descarga.js solo en pantalla estrecha y táctil) */
.movil-caja { scroll-margin-top: 84px; margin-top: 14px; padding: 18px; background: var(--panel); border: 1px solid var(--linea2); border-radius: 8px; }
.movil-tit { margin: 0 0 6px; font: 600 20px/1.2 var(--f-texto); color: var(--texto); }
.movil-txt { margin: 0 0 14px; color: var(--texto2); font-size: 15px; }
.movil-caja .boton { white-space: normal; text-align: center; justify-content: center; }
.movil-zip { margin: 14px 0 0; font-size: 14px; }
.movil-zip a { color: var(--texto2); text-decoration-color: var(--linea2); text-underline-offset: 3px; }
.movil-estado { margin: 10px 0 0; font-size: 14px; font-weight: 600; color: var(--oro); overflow-wrap: anywhere; }
.movil-estado:empty { display: none; }
/* campo «envíate el enlace por correo» (solo si hay servidor; ML-295): 16 px en el campo para que iOS no amplíe la página al enfocarlo */
.movil-correo { margin: 0 0 14px; }
.movil-correo .movil-txt { margin-bottom: 10px; }
.movil-correo-fila { display: flex; gap: 8px; align-items: stretch; }
.movil-correo-fila input { flex: 1 1 auto; min-width: 0; font: 16px var(--f-texto); color: var(--texto); background: var(--panel2); border: 1px solid var(--linea2); border-radius: 8px; padding: 10px 12px; }
.movil-correo-fila input:focus-visible { outline: 2px solid var(--oro); outline-offset: 1px; }
.movil-caja .movil-correo-fila .boton { width: auto; flex: 0 0 auto; }
.movil-correo-nota { margin: 8px 0 0; font-size: 13.5px; color: var(--texto2); }
.movil-correo-estado { margin: 8px 0 0; font-size: 14px; font-weight: 600; color: var(--oro); overflow-wrap: anywhere; }
.movil-correo-estado.error { color: #ff9b9b; }
.movil-correo-estado:empty { display: none; }

/* ---------------- Magic Online (2.3) */
.mtgo-caja { margin-top: 28px; background: var(--panel); border: 1px solid var(--linea2); border-radius: 8px; padding: 28px; }
.mtgo-caja h3 { font-size: 22px; margin: 0 0 14px; }
.mtgo-caja ul { margin: 0; padding-left: 20px; color: var(--texto2); display: grid; gap: 9px; font-size: 15.5px; max-width: 78ch; }
.mtgo-caja li b { color: var(--texto); font-weight: 600; }
.mtgo-caja code { font: 13px var(--f-mono); background: var(--panel2); border: 1px solid var(--linea); border-radius: 6px; padding: 1px 6px; color: var(--texto); }
.funcion .enlace-man { display: inline-block; margin-top: 10px; font-weight: 500; font-size: 15px; color: var(--texto); }
@media (max-width: 480px) { .mtgo-caja { padding: 20px 18px; } }

/* ---------------- novedades 2.2 */
{{@13}}
.novedad { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 56px; align-items: center; }
.novedad:nth-child(even) { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
.novedad:nth-child(even) .ventana { order: 2; }
.novedades.mtgo-capturas { margin-top: 28px; }
details[id] { scroll-margin-top: 90px; }
.novedad .ventana { align-self: center; }
/* sin «aspect-ratio: auto»: así el navegador reserva el alto de cada imagen con sus width/height y las imágenes perezosas no desplazan la página al cargar */
.novedad .ventana img { height: auto; object-fit: contain; }
.novedad .ventana.estrecha { justify-self: center; width: 100%; max-width: 440px; }
.novedad h3 { font-size: 26px; line-height: 1.2; margin: 12px 0 10px; }
.novedad p { margin: 0; color: var(--texto2); font-size: 17px; line-height: 1.6; max-width: 52ch; }
@media (max-width: 900px) {
  .novedades { gap: 56px; }
  .novedad, .novedad:nth-child(even) { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .novedad:nth-child(even) .ventana { order: 0; }
}

/* capturas inclinadas (WEB-04): solo imágenes fijas marcadas con .inclinable en bloques alternos, solo con ratón y con sitio; nunca vídeos ni teléfono */
@media (min-width: 901px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
  .novedad:has(> .ventana.inclinable) { perspective: 1400px; }
  .novedad > .ventana.inclinable { transform: rotateY(-14deg) rotateX(5deg); transform-origin: left center; transition: transform .5s ease; }
  .novedad:nth-child(even) > .ventana.inclinable { transform: rotateY(14deg) rotateX(5deg); transform-origin: right center; }
  .novedad:hover > .ventana.inclinable, .novedad:focus-within > .ventana.inclinable { transform: none; }
}
